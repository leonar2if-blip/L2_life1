<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_capture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Action: Task -->
    <LinearLayout
        android:id="@+id/widget_action_task"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Nueva Tarea"
            android:src="@drawable/ic_shortcut_task" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+ Tarea"
            android:textColor="#F3F4F6"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action: Note -->
    <LinearLayout
        android:id="@+id/widget_action_note"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Nueva Nota"
            android:src="@drawable/ic_shortcut_note" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+ Nota"
            android:textColor="#F3F4F6"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action: Focus -->
    <LinearLayout
        android:id="@+id/widget_action_focus"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Temporizador Focus"
            android:src="@drawable/ic_shortcut_focus" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Focus"
            android:textColor="#F3F4F6"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action: Diary -->
    <LinearLayout
        android:id="@+id/widget_action_diary"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Diario"
            android:src="@drawable/ic_shortcut_diary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Diario"
            android:textColor="#F3F4F6"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
